# Supabase 대시보드 > Project Settings > API 에서 복사하세요
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에-anon-public-키

# (선택) 카카오톡 공유 버튼용. Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=

# (선택) 카카오톡 예약 알림용. 아래 값은 서버에서만 써요. 앞에 NEXT_PUBLIC_ 을 붙이지 마세요.
# Supabase 대시보드 > Project Settings > API Keys 의 secret 키 (또는 service_role 키)
SUPABASE_SECRET_KEY=
# Kakao Developers > 앱 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=
# 같은 화면의 클라이언트 시크릿 (켜져 있으면 꼭 넣어요)
KAKAO_CLIENT_SECRET=
